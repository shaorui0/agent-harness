{
  "_comment": "Source of truth for harness hook registrations. `harness install` merges these into ~/.claude/settings.json without touching anything else. Entries are identified by their command string, so re-running is idempotent.",
  "SessionStart": [
    {
      "hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-session-start.py", "timeout": 10}
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-prompt-contract.py", "timeout": 5},
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-prompt-prehook.py", "timeout": 5}
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash|Edit|Write|NotebookEdit",
      "hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-envelope.py", "timeout": 10}
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash|Edit|Write|NotebookEdit",
      "hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-oplog.py", "timeout": 15}
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-journal.py", "timeout": 15},
        {"type": "command", "command": "python3 ~/.claude/hooks/harness-stop-contract.py", "timeout": 10}
      ]
    }
  ]
}
